FROM python:3.12-slim

WORKDIR /app

# libgl1 / libglib2.0 are required by OpenCV even in headless mode
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    torch==2.4.1 \
    torchvision==0.19.1 \
    --index-url https://download.pytorch.org/whl/cu121

RUN pip install --no-cache-dir \
    fastapi==0.121.3 \
    uvicorn==0.34.1 \
    pydantic==2.11.3 \
    pyyaml==6.0.2 \
    ultralytics==8.4.51 \
    pydicom \
    opencv-python-headless \
    Pillow \
    numpy

COPY app/ ./app/

EXPOSE 8000
CMD ["uvicorn", "app.runtime_server:app", "--host", "0.0.0.0", "--port", "8000"]
