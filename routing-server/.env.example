# MongoDB
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
DB_NAME=maple_db
REQUIRE_REPLICA_SET=true
# MongoDB departments 컬렉션 문서 ObjectId (python-dotenv는 인라인 주석을 값으로 읽으므로 별도 줄에 작성)
MAIN_DOCUMENT_ID=

# 인증 — 운영에서는 반드시 충분히 긴 무작위 값 사용
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# 단일 병원
HOSPITAL_ID=champion
HOSPITAL_NAME=챔피언 병원
APP_TIMEZONE=Asia/Seoul
MAX_UPLOAD_BYTES=536870912
GRIDFS_BUCKET=fs
CLINICAL_WORK_DIR=./data/clinical-work
FILE_SIGNING_SECRET=
FILE_SIGNED_URL_SECONDS=300
AUDIT_RETENTION_DAYS=365

# 분석 worker
ANALYSIS_WORKER_ENABLED=true
ANALYSIS_WORKER_ID=
ANALYSIS_GLOBAL_CONCURRENCY=3
ANALYSIS_LEASE_SECONDS=300
ANALYSIS_MAX_ATTEMPTS=2
ANALYSIS_POLL_INTERVAL_SECONDS=2

# 임상 채팅
CHAT_MAX_HISTORY_MESSAGES=40
CHAT_MAX_CONTEXT_ANALYSES=20
CHAT_MAX_CONTEXT_CHARS=24000

# React 개발 / Electron 프로덕션 origin
CLIENT_ORIGINS=http://localhost:3000,app://maple

# AI Agent 서버 주소
AGENT_URL=http://localhost:8101
AGENT_TIMEOUT=300

# 추론 서버
MAPLE_INFERENCE_URL=http://localhost:8110
MAPLE_INFERENCE_HEALTH_PATH=/health
MAPLE_REMOTE_INFERENCE_URL=

# 모델 경로
AI_MODELS_DIR=../model-execution-server/AI_Models
MODEL_ROOT=
